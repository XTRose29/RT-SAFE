# Copy to a shell-local file, replace the paths, then: source online_rl.env
export REALTIME_ROOT=/path/to/SimWorld-RealTime
export SIMWORLD_NAV_ROOT=/path/to/simworld-nav-pr3
export VAGEN_ROOT="$SIMWORLD_NAV_ROOT/vendor/vagen"
export MODEL_PATH=/path/to/Qwen3-VL-4B-Instruct

# Packaged Unreal build. UE and training GPU sets MUST NOT overlap.
export UE_LAUNCHER=/path/to/Linux-runtime/SimWorld.sh
export UE_GPUS="0 1 2 3"
export UE_PORTS="9010 9020 9030 9040"
export SIMWORLD_RL_UE_ENDPOINTS=/tmp/simworld-rt-endpoints.json
export UE_LOG_DIR=/tmp/simworld-rt-ue-logs

# These are logical IDs after CUDA_VISIBLE_DEVICES is applied.
export CUDA_VISIBLE_DEVICES=4,5,6,7
export N_GPUS=4
export MIN_TRAIN_GPU_FREE_MB=18000
export AGENT_WORKERS=4
export TRAIN_BS=4
export GROUP=4
export EXPERIMENT_DIR="$REALTIME_ROOT/exps/grpo_realtime"
export WANDB_MODE=offline
